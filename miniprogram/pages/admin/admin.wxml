<!-- 管理后台 -->
<view class="page-container">
  <!-- 自定义导航栏 -->
  <view class="custom-navbar">
    <view class="nav-placeholder" style="height: {{statusBarHeight}}px;"></view>
    <view class="navbar-content">
      <view class="navbar-left">
        <view class="nav-btn back-btn" bindtap="goBack">
          <view class="back-arrow"></view>
        </view>
        <view class="nav-btn notify-btn" bindtap="openOrderNotify">
          <view class="bell-icon">
            <view class="bell-body {{notifyEnabled ? 'bell-body-active' : ''}}"></view>
            <view class="bell-top {{notifyEnabled ? 'bell-top-active' : ''}}"></view>
            <view class="bell-dot" wx:if="{{!notifyEnabled}}"></view>
          </view>
        </view>
      </view>
      <view class="navbar-center">
        <text class="navbar-title">管理后台</text>
      </view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="content-area" style="padding-top: {{navTotalHeight}}px;">
    <!-- 横向 stats（点击即筛选，跟"我的"页面一致） -->
    <view class="stats-bar">
      <view class="stat-item {{currentFilter === 'all' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="all">
        <text class="stat-num {{currentFilter === 'all' ? 'active' : ''}}">{{totalCount}}</text>
        <text class="stat-label {{currentFilter === 'all' ? 'active' : ''}}">全部</text>
      </view>
      <view class="stat-item {{currentFilter === 'unpaid' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="unpaid">
        <text class="stat-num {{currentFilter === 'unpaid' ? 'active' : ''}}">{{unpaidCount}}</text>
        <text class="stat-label {{currentFilter === 'unpaid' ? 'active' : ''}}">待付款</text>
      </view>
      <view class="stat-item {{currentFilter === 'paid' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="paid">
        <text class="stat-num {{currentFilter === 'paid' ? 'active' : ''}}">{{paidCount}}</text>
        <text class="stat-label {{currentFilter === 'paid' ? 'active' : ''}}">待确认</text>
      </view>
      <view class="stat-item {{currentFilter === 'pending' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="pending">
        <text class="stat-num {{currentFilter === 'pending' ? 'active' : ''}}">{{pendingCount}}</text>
        <text class="stat-label {{currentFilter === 'pending' ? 'active' : ''}}">待处理</text>
      </view>
      <view class="stat-item {{currentFilter === 'doing' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="doing">
        <text class="stat-num {{currentFilter === 'doing' ? 'active' : ''}}">{{doingCount}}</text>
        <text class="stat-label {{currentFilter === 'doing' ? 'active' : ''}}">进行中</text>
      </view>
      <view class="stat-item {{currentFilter === 'done' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="done">
        <text class="stat-num {{currentFilter === 'done' ? 'active' : ''}}">{{doneCount}}</text>
        <text class="stat-label {{currentFilter === 'done' ? 'active' : ''}}">已完成</text>
      </view>
      <view class="stat-item {{currentFilter === 'cancelled' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="cancelled">
        <text class="stat-num {{currentFilter === 'cancelled' ? 'active' : ''}}">{{cancelledCount}}</text>
        <text class="stat-label {{currentFilter === 'cancelled' ? 'active' : ''}}">已取消</text>
      </view>
    </view>

    <!-- 订单列表 -->
    <view class="order-list" wx:if="{{orders.length > 0}}">
      <view class="order-card" wx:for="{{orders}}" wx:key="_id" bindtap="goDetail" data-id="{{item._id}}">
        <!-- 第一行：文件名 + 状态 tag -->
        <view class="card-row-top">
          <text class="file-title">{{item.fileName || '未命名文件'}}</text>
          <view class="status-tag status-{{item.payStatus === 'paid' && item.status !== 'cancelled' ? 'paid' : item.status}}">
            <text>{{item.payStatus === 'paid' && item.status !== 'cancelled' ? '待确认' : item.statusText}}</text>
          </view>
        </view>
        <!-- 第二行：金额 -->
        <view class="card-row-mid">
          <text class="amount-label">金额 </text>
          <text class="price-symbol">¥</text>
          <text class="price-num">{{item.priceStr}}</text>
        </view>
        <!-- 第三行：时间 + 查看详情 -->
        <view class="card-row-bot">
          <text class="time-text">{{item.createTimeStr}}</text>
          <view class="detail-link">
            <text>查看详情</text>
            <view class="arrow-right"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{orders.length === 0 && !loading}}">
      <view class="empty-icon">
        <text class="empty-icon-char">📋</text>
      </view>
      <text class="empty-text">暂无订单数据</text>
    </view>

    <!-- 加载中 -->
    <view class="loading-state" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore && orders.length > 0}}" bindtap="loadMore">
      <text>加载更多</text>
    </view>

    <view class="bottom-spacing"></view>
  </view>
</view>