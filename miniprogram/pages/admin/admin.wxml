<!-- 管理后台 -->
<view class="page-container">
  <!-- 自定义导航栏 -->
  <view class="custom-navbar">
    <view class="nav-placeholder" style="height: {{statusBarHeight}}px;"></view>
    <view class="navbar-content">
      <view class="navbar-left">
        <view class="nav-btn back-btn" bindtap="goBack">
          <view class="back-arrow"></view>
        </view>
        <view class="nav-btn notify-btn" bindtap="requestSubscribeMessage">
          <view class="bell-icon">
            <view class="bell-body"></view>
            <view class="bell-top"></view>
            <view class="bell-dot" wx:if="{{!notifyEnabled}}"></view>
          </view>
        </view>
      </view>
      <view class="navbar-center">
        <text class="navbar-title">管理后台</text>
      </view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="content-area" style="padding-top: {{navTotalHeight}}px;">
    <!-- 统计Banner -->
    <view class="stats-banner">
      <view class="banner-decoration banner-deco-tl"></view>
      <view class="banner-decoration banner-deco-br"></view>
      <view class="stats-main">
        <text class="stats-total-num">{{totalCount}}</text>
        <text class="stats-total-label">总订单</text>
      </view>
      <view class="stats-grid">
        <view class="stat-item">
          <text class="stat-num stat-orange">{{unpaidCount}}</text>
          <text class="stat-label">待付款</text>
        </view>
        <view class="stat-item">
          <text class="stat-num stat-blue">{{paidCount}}</text>
          <text class="stat-label">待确认</text>
        </view>
        <view class="stat-item">
          <text class="stat-num stat-purple">{{pendingCount}}</text>
          <text class="stat-label">待处理</text>
        </view>
        <view class="stat-item">
          <text class="stat-num stat-gold">{{doingCount}}</text>
          <text class="stat-label">进行中</text>
        </view>
        <view class="stat-item">
          <text class="stat-num stat-green">{{doneCount}}</text>
          <text class="stat-label">已完成</text>
        </view>
      </view>
    </view>

    <!-- 筛选标签 -->
    <scroll-view scroll-x class="filter-scroll">
      <view class="filter-bar">
        <view class="filter-tab {{currentFilter === 'all' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="all">全部</view>
        <view class="filter-tab {{currentFilter === 'unpaid' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="unpaid">待付款</view>
        <view class="filter-tab {{currentFilter === 'paid' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="paid">待确认</view>
        <view class="filter-tab {{currentFilter === 'pending' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="pending">待处理</view>
        <view class="filter-tab {{currentFilter === 'doing' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="doing">进行中</view>
        <view class="filter-tab {{currentFilter === 'done' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="done">已完成</view>
        <view class="filter-tab {{currentFilter === 'cancelled' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="cancelled">已取消</view>
      </view>
    </scroll-view>

    <!-- 订单列表 -->
    <view class="order-list" wx:if="{{orders.length > 0}}">
      <view class="order-card" wx:for="{{orders}}" wx:key="_id">
        <view class="order-header">
          <view class="order-id-wrap">
            <text class="order-id-prefix">#</text>
            <text class="order-id">{{item.orderNo}}</text>
          </view>
          <view class="status-tag status-{{item.payStatus === 'paid' ? 'paid' : item.status}}">
            <text>{{item.payStatus === 'paid' ? '待确认' : item.statusText}}</text>
          </view>
        </view>
        <view class="order-body">
          <view class="info-row">
            <text class="info-label">客户</text>
            <text class="info-value">{{item.name}} · {{item.phone}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">文件</text>
            <text class="info-value file-name">{{item.fileName}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">支付</text>
            <text class="info-value pay-status-{{item.payStatus}}">{{item.payStatusText}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">字数</text>
            <text class="info-value">{{item.wordCount}} 字</text>
          </view>
        </view>
        <view class="order-footer">
          <view class="price-wrap">
            <text class="price-symbol">¥</text>
            <text class="price-num">{{item.priceStr}}</text>
          </view>
          <view class="order-actions">
            <view class="action-btn action-default" bindtap="goDetail" data-id="{{item._id}}">
              <text>查看</text>
            </view>
            <view class="action-btn action-confirm" wx:if="{{item.payStatus === 'paid'}}" bindtap="confirmPayment" data-id="{{item._id}}">
              <text>确认收款</text>
            </view>
            <view class="action-btn action-delete" bindtap="deleteOrder" data-id="{{item._id}}">
              <text>删除</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{orders.length === 0 && !loading}}">
      <view class="empty-circle">
        <text class="empty-char">管</text>
      </view>
      <text class="empty-text">暂无订单数据</text>
    </view>

    <!-- 加载中 -->
    <view class="loading-state" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore && orders.length > 0}}" bindtap="loadMore">
      <text>加载更多</text>
    </view>

    <view class="bottom-spacing"></view>
  </view>
</view>
