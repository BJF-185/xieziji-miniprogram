/* 管理后台 - 新中式极简风格 */
.page-container {
  min-height: 100vh;
  background-color: #f8f7f4;
}

/* === 自定义导航栏 === */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #f8f7f4;
}

.nav-placeholder {
  width: 100%;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  position: relative;
}

.navbar-left,
.navbar-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.navbar-center {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.navbar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s cubic-bezier(0.23, 1, 0.32, 1);
}

.nav-btn:active {
  transform: scale(0.92);
  background-color: rgba(0, 0, 0, 0.05);
}

/* 铃铛图标 */
.bell-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.bell-body {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #c9a227;
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  background: transparent;
  transition: all 0.2s;
}

.bell-body-active {
  background: #c9a227;
  border-color: #c9a227;
}

.bell-top {
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  background: #c9a227;
  border-radius: 50%;
  transition: all 0.2s;
}

.bell-top-active {
  background: #c9a227;
  width: 10rpx;
  height: 10rpx;
}

.bell-dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 12rpx;
  height: 12rpx;
  background: #c41e3a;
  border-radius: 50%;
  border: 2rpx solid #f8f7f4;
}

/* 返回箭头图标 */
.back-arrow {
  width: 22rpx;
  height: 22rpx;
  border-left: 3rpx solid #1a1a1a;
  border-bottom: 3rpx solid #1a1a1a;
  transform: rotate(45deg);
  margin-left: 4rpx;
}

/* === 内容区域 === */
.content-area {
  padding: 24rpx 32rpx;
  padding-bottom: 40rpx;
}

/* === 横向 stats（点击即筛选，跟"我的"页面一致） === */
.stats-bar {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stats-bar .stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  padding: 4rpx 0 8rpx;
  transition: all 0.2s cubic-bezier(0.23, 1, 0.32, 1);
}

.stats-bar .stat-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 4rpx;
  background: #1a1a1a;
  border-radius: 2rpx;
  transition: width 0.25s cubic-bezier(0.23, 1, 0.32, 1);
}

.stats-bar .stat-item.active::after {
  width: 32rpx;
}

.stats-bar .stat-num {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #b0b0b0;
  font-family: 'Noto Serif SC', serif;
  transition: color 0.2s;
}

.stats-bar .stat-num.active {
  color: #1a1a1a;
  font-weight: 700;
}

.stats-bar .stat-label {
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 6rpx;
  font-weight: 400;
  transition: color 0.2s;
}

.stats-bar .stat-label.active {
  color: #1a1a1a;
  font-weight: 500;
}



/* === 订单列表（3 行简洁卡片） === */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s cubic-bezier(0.23, 1, 0.32, 1);
}

.order-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

/* 第一行：文件名 + 状态 tag */
.card-row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.file-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 20rpx;
}

/* 第二行：金额 */
.card-row-mid {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.amount-label {
  font-size: 28rpx;
  color: #999999;
  font-weight: 500;
  margin-right: 8rpx;
}

.price-symbol {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-right: 2rpx;
}

.price-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  font-family: 'Noto Serif SC', serif;
}

/* 第三行：时间 + 查看详情 */
.card-row-bot {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.time-text {
  font-size: 24rpx;
  color: #999999;
  font-weight: 400;
}

.detail-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.detail-link text {
  font-size: 24rpx;
  color: #999999;
  font-weight: 400;
}

.arrow-right {
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid #999999;
  border-bottom: 2rpx solid #999999;
  transform: rotate(-45deg);
  flex-shrink: 0;
}

/* === 状态 tag（纯色 + 白字） === */
.status-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #ffffff;
  flex-shrink: 0;
}

.status-tag text {
  font-size: 22rpx;
}

.status-unpaid { background-color: #F59E0B; }
.status-paid { background-color: #3B82F6; }
.status-pending { background-color: #8B5CF6; }
.status-doing { background-color: #8B5CF6; }
.status-done { background-color: #22C55E; }
.status-cancelled { background-color: #9CA3AF; }

/* === 空状态（对齐 order 页面） === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f5f5f0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-icon-char {
  font-size: 56rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #b0b0b0;
  font-weight: 500;
}

/* === 加载中 === */
.loading-state {
  text-align: center;
  padding: 80rpx;
  color: #b0b0b0;
  font-size: 26rpx;
}

/* === 加载更多 === */
.load-more {
  text-align: center;
  padding: 32rpx;
  color: #1a1a1a;
  font-size: 26rpx;
  font-weight: 500;
  transition: opacity 0.2s;
}

.load-more:active {
  opacity: 0.6;
}

.bottom-spacing {
  height: 60rpx;
}