.page-container {
  min-height: 100vh;
  background-color: #f8f7f4;
  position: relative;
}

.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #f8f7f4;
}

.nav-placeholder {
  width: 100%;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  position: relative;
}

.navbar-left, .navbar-right {
  width: 80rpx;
  height: 100%;
  display: flex;
  align-items: center;
}

.navbar-left {
  padding-left: 8rpx;
}

.back-icon {
  width: 22rpx;
  height: 22rpx;
  border-left: 4rpx solid #1a1a1a;
  border-bottom: 4rpx solid #1a1a1a;
  transform: rotate(45deg);
}

.navbar-center {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.navbar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
}

.content-area {
  padding: 24rpx 32rpx;
  padding-bottom: 240rpx;
}

/* === 成功卡片 === */
.success-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 56rpx 36rpx 40rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  text-align: center;
  margin-bottom: 24rpx;
}

.success-icon-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}

.success-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #34c759;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-check {
  width: 28rpx;
  height: 52rpx;
  border-right: 6rpx solid #ffffff;
  border-bottom: 6rpx solid #ffffff;
  transform: rotate(45deg);
  margin-top: -10rpx;
}

.success-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
}

.success-desc {
  font-size: 26rpx;
  color: #999999;
  margin-top: 12rpx;
  display: block;
}

/* === 信息区域 === */
.info-section {
  margin-top: 36rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #999999;
}

.info-value {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.status-paid {
  color: #22C55E;
  font-weight: 600;
}

/* === 引导卡片 === */
.guide-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.guide-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 36rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  position: relative;
}

.step-circle {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
  background-color: #f5f5f5;
  border-radius: 50%;
  flex-shrink: 0;
  z-index: 2;
  position: relative;
}

.step-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 25rpx;
  top: 52rpx;
  width: 2rpx;
  height: calc(100% + 28rpx - 52rpx);
  border-left: 2rpx dashed #e0e0e0;
  z-index: 1;
}

.step-body {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding-bottom: 28rpx;
}

.step-item:last-child .step-body {
  padding-bottom: 0;
}

.step-text {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 500;
  line-height: 1.5;
}

.step-subtext {
  font-size: 24rpx;
  color: #b0b0b0;
  margin-top: 8rpx;
  display: block;
  line-height: 1.4;
}

.bottom-spacing {
  height: 40rpx;
}

/* === 底部栏 === */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #f8f7f4;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.confirm-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #1a1a1a !important;
  color: #ffffff !important;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none !important;
  padding: 0;
  margin: 0;
  text-align: center;
  letter-spacing: 4rpx;
}

.confirm-btn::after {
  border: none !important;
}

.confirm-btn:active {
  background: #333333 !important;
  opacity: 0.9;
  transform: scale(0.98);
}

.home-link {
  font-size: 28rpx;
  color: #999999;
  margin-top: 20rpx;
  padding: 8rpx 0;
  letter-spacing: 2rpx;
}

.home-link:active {
  color: #666666;
}
