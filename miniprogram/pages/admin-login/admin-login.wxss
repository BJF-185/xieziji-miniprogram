/* 管理员登录页 - 新中式极简风格 */
.page-container {
  min-height: 100vh;
  background-color: #f8f7f4;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  overflow: hidden;
}

/* === 返回按钮 === */
.back-btn {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: calc(88rpx + env(safe-area-inset-top));
  padding-top: env(safe-area-inset-top);
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 24rpx;
  z-index: 100;
}

.back-btn:active .back-icon {
  opacity: 0.5;
}

.back-icon {
  width: 20rpx;
  height: 20rpx;
  border-left: 3rpx solid #1a1a1a;
  border-bottom: 3rpx solid #1a1a1a;
  transform: rotate(45deg);
  margin-left: 12rpx;
  transition: opacity 0.2s;
}

/* === 装饰印章 === */
.deco-seal {
  position: fixed;
  top: calc(120rpx + env(safe-area-inset-top));
  right: 40rpx;
  width: 72rpx;
  height: 72rpx;
  background: #c41e3a;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  opacity: 0.12;
  transform: rotate(-8deg);
  letter-spacing: 0;
}

/* === 装饰圆圈 === */
.deco-circle {
  position: fixed;
  border-radius: 50%;
  border: 1rpx solid rgba(201, 162, 39, 0.08);
  pointer-events: none;
}

.deco-circle-1 {
  width: 400rpx;
  height: 400rpx;
  top: -100rpx;
  left: -150rpx;
}

.deco-circle-2 {
  width: 300rpx;
  height: 300rpx;
  bottom: -80rpx;
  right: -100rpx;
}

/* === 主要内容 === */
.login-content {
  width: 100%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* === Logo区域 === */
.logo-area {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.logo-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1a1a1a 0%, #2a2520 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(26, 26, 26, 0.15);
  position: relative;
  z-index: 2;
}

.logo-char {
  font-size: 56rpx;
  font-weight: 700;
  color: #c9a227;
}

.logo-line {
  position: absolute;
  top: 50%;
  width: 120rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(201, 162, 39, 0.3), transparent);
}

.logo-line-left {
  right: 100%;
  margin-right: 24rpx;
}

.logo-line-right {
  left: 100%;
  margin-left: 24rpx;
}

/* === 标题区域 === */
.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 8rpx;
  margin-bottom: 16rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #b0b0b0;
  font-weight: 400;
  letter-spacing: 2rpx;
}

/* === 表单区域 === */
.form-area {
  width: 100%;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 0 24rpx;
  height: 104rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
  transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
  margin-bottom: 40rpx;
}

.input-wrap.focused {
  border-color: rgba(201, 162, 39, 0.3);
  box-shadow: 0 4rpx 24rpx rgba(201, 162, 39, 0.1);
}

/* 锁图标 */
.input-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.lock-body {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 22rpx;
  background: #d0d0d0;
  border-radius: 4rpx;
  transition: background 0.3s;
}

.input-wrap.focused .lock-body {
  background: #c9a227;
}

.lock-shackle {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 18rpx;
  height: 14rpx;
  border: 3rpx solid #d0d0d0;
  border-bottom: none;
  border-radius: 12rpx 12rpx 0 0;
  transition: border-color 0.3s;
}

.input-wrap.focused .lock-shackle {
  border-color: #c9a227;
}

.password-input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #1a1a1a;
  letter-spacing: 4rpx;
}

.input-placeholder {
  color: #d0d0d0;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

/* 密码可见切换 */
.toggle-pwd {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
  border-radius: 50%;
  transition: background 0.2s;
}

.toggle-pwd:active {
  background: rgba(0, 0, 0, 0.04);
}

.eye-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
}

.eye-outer {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 28rpx;
  height: 18rpx;
  border: 2rpx solid #c0c0c0;
  border-radius: 50% / 60% 60% 40% 40%;
  transition: border-color 0.2s;
}

.toggle-pwd:active .eye-outer {
  border-color: #1a1a1a;
}

.eye-pupil {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 8rpx;
  height: 8rpx;
  background: #c0c0c0;
  border-radius: 50%;
  transition: background 0.2s;
}

.toggle-pwd:active .eye-pupil {
  background: #1a1a1a;
}

.eye-line {
  position: absolute;
  top: 50%;
  left: -2rpx;
  width: 36rpx;
  height: 2rpx;
  background: #c0c0c0;
  transform: rotate(-30deg) translateY(-50%);
  transform-origin: center;
  border-radius: 1rpx;
}

/* === 登录按钮 === */
.login-btn {
  position: relative;
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #1a1a1a 0%, #2a2520 100%);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 26, 0.2);
}

.login-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 26, 0.15);
}

.login-btn.btn-disabled {
  background: #e0e0e0;
  box-shadow: none;
}

.login-btn.btn-disabled:active {
  transform: none;
}

.login-btn.btn-loading {
  background: linear-gradient(135deg, #2a2520 0%, #3a3530 100%);
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #c9a227;
  letter-spacing: 12rpx;
  text-indent: 12rpx;
}

.btn-disabled .btn-text {
  color: #ffffff;
  opacity: 0.5;
}

.btn-loading .btn-text {
  color: #c9a227;
  opacity: 0.8;
}

/* 按钮微光效果 */
.btn-shine {
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(201, 162, 39, 0.15), transparent);
  animation: btnShine 3s ease-in-out infinite;
}

@keyframes btnShine {
  0% {
    left: -100%;
  }
  50%, 100% {
    left: 150%;
  }
}

/* === 底部提示 === */
.footer-tip {
  margin-top: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip-text {
  font-size: 22rpx;
  color: #c0c0c0;
  letter-spacing: 2rpx;
}
