<view class="page-container">
  <view class="custom-navbar">
    <view class="nav-placeholder" style="height: {{statusBarHeight}}px;"></view>
    <view class="navbar-content">
      <view class="navbar-left" bindtap="goBack">
        <view class="back-icon"></view>
      </view>
      <view class="navbar-center">
        <text class="navbar-title">确认</text>
      </view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <view class="content-area" style="padding-top: {{navTotalHeight}}px;">
    <view class="guide-card">
      <view class="guide-title">请按以下步骤完成</view>

      <view class="step-item">
        <view class="step-circle">1</view>
        <view class="step-body">
          <view class="step-main">
            <text class="step-text">点击复制</text>
            <view class="step-right">
              <view class="step-amount">
                <text class="amount-symbol">¥</text>
                <text class="amount-num">{{totalPrice}}</text>
              </view>
              <view class="copy-btn {{hasCopiedAmount ? 'copied' : ''}}" bindtap="copyAmount" data-amount="{{totalPrice}}">
                <text>{{hasCopiedAmount ? '已复制' : '复制'}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="step-item">
        <view class="step-circle">2</view>
        <view class="step-body">
          <text class="step-text">长按识别二维码，直达聊天页面</text>

          <view class="qr-wrapper" bindlongpress="onQrLongPress">
            <image class="qr-image" src="{{wechatQRUrl}}" mode="widthFix" binderror="onQrError" show-menu-by-longpress="true"></image>
          </view>
        </view>
      </view>

      <view class="step-item">
        <view class="step-circle">3</view>
        <view class="step-body">
          <text class="step-text">提交截图</text>

          <view wx:if="{{!proofFileID && !proofUploading}}" class="proof-uploader" bindtap="chooseProof">
            <image class="proof-example" src="{{transferExampleUrl}}" mode="aspectFit" binderror="onExampleError"></image>
            <text class="proof-example-label">参考示例</text>
            <text class="proof-uploader-text">点击上传您的截图</text>
          </view>

          <view wx:elif="{{proofUploading}}" class="proof-uploader">
            <text class="proof-uploader-text">上传中...</text>
          </view>

          <view wx:else class="proof-preview-wrap">
            <image class="proof-thumb" src="{{proofTempPath}}" mode="widthFix" show-menu-by-longpress="true"></image>
            <view class="proof-remove" bindtap="removeProof">
              <view class="proof-remove-x"></view>
            </view>
          </view>
        </view>
      </view>

      <view class="step-item">
        <view class="step-circle">4</view>
        <view class="step-body">
          <text class="step-text">点击下方按钮完成</text>
        </view>
      </view>
    </view>

    <view class="bottom-spacing"></view>
  </view>

  <view class="bottom-bar">
    <view class="confirm-btn {{paymentSubmitted ? 'submitted' : ''}} {{canSubmit ? '' : 'disabled'}}" bindtap="{{paymentSubmitted || !canSubmit ? '' : 'confirmPayment'}}">
      <text wx:if="{{paymentSubmitted}}">已完成</text>
      <text wx:elif="{{!canSubmit}}">请先上传截图</text>
      <text wx:else>完成</text>
    </view>
  </view>
</view>
