<view class="page-container page-with-tabbar">
  <view class="custom-navbar">
    <view class="nav-placeholder" style="height: {{statusBarHeight}}px;"></view>
    <view class="navbar-content">
      <view class="navbar-left"></view>
      <view class="navbar-center">
        <text class="navbar-title">我的</text>
      </view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <view class="content-area" style="padding-top: {{navTotalHeight}}px;">
    <view class="filter-card">
      <view class="filter-item {{currentFilter === 'all' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="all">
        <text class="filter-num">{{totalCount}}</text>
        <text class="filter-label">全部</text>
      </view>
      <view class="filter-item {{currentFilter === 'unpaid' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="unpaid">
        <text class="filter-num">{{unpaidCount}}</text>
        <text class="filter-label">待付款</text>
      </view>
      <view class="filter-item {{currentFilter === 'pending' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="pending">
        <text class="filter-num">{{queuingCount}}</text>
        <text class="filter-label">排队中</text>
      </view>
      <view class="filter-item {{currentFilter === 'doing' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="doing">
        <text class="filter-num">{{processingCount}}</text>
        <text class="filter-label">处理中</text>
      </view>
      <view class="filter-item {{currentFilter === 'done' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="done">
        <text class="filter-num">{{doneCount}}</text>
        <text class="filter-label">已完成</text>
      </view>
    </view>

    <view class="order-list" wx:if="{{filteredOrders.length > 0}}">
      <view class="order-card" wx:for="{{filteredOrders}}" wx:key="_id" bindtap="goDetail" data-id="{{item._id}}">
        <view class="order-header">
          <text class="order-title">{{item.fileName}}</text>
          <view class="status-tag status-{{item.displayStatus}}">
            <text>{{item.statusText}}</text>
          </view>
        </view>
        <view class="order-body">
          <view class="order-row" wx:if="{{item.price}}">
            <text class="row-label">金额</text>
            <view class="row-value price-wrap">
              <text class="price-symbol">¥</text>
              <text class="price-num">{{item.price}}</text>
            </view>
          </view>
        </view>
        <view class="order-footer">
          <text class="order-time">{{item.createTimeStr}}</text>
          <view class="order-action">
            <view class="btn-pay" wx:if="{{item.displayStatus === 'unpaid'}}" catchtap="goPayment" data-id="{{item._id}}">
              <text>去支付</text>
            </view>
            <view class="detail-link" wx:else catchtap="goDetail" data-id="{{item._id}}">
              <text>查看详情</text>
              <view class="arrow-icon"></view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{filteredOrders.length === 0 && !loading}}">
      <view class="empty-circle">
        <text class="empty-char">约</text>
      </view>
      <text class="empty-text">{{currentFilter === 'all' ? '暂无预约记录' : '该状态下暂无预约'}}</text>
      <view class="empty-btn" wx:if="{{currentFilter === 'all'}}" bindtap="goOrder">
        <text>去预约</text>
      </view>
    </view>

    <view class="loading-state" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <view class="bottom-spacing"></view>
  </view>

  <view class="tab-bar-container">
    <view class="tab-bar-blur"></view>
    <view class="tab-bar-icons">
      <view class="tab-item {{currentTab === 'home' ? 'active' : ''}}" bindtap="onTabHome">
        <image class="tab-icon" src="{{currentTab === 'home' ? '/images/tabbar/home-active.png' : '/images/tabbar/home.png'}}"/>
        <text class="tab-label">首页</text>
      </view>
      <button class="tab-item tab-contact" open-type="contact">
        <image class="tab-icon" src="{{currentTab === 'chat' ? '/images/tabbar/chat-active.png' : '/images/tabbar/chat.png'}}"/>
        <text class="tab-label">咨询</text>
      </button>
      <view class="tab-item {{currentTab === 'my' ? 'active' : ''}}" bindtap="onTabMy">
        <image class="tab-icon" src="{{currentTab === 'my' ? '/images/tabbar/user-active.png' : '/images/tabbar/user.png'}}"/>
        <text class="tab-label">我的</text>
      </view>
    </view>
  </view>
</view>
