.page-container {
  min-height: 100vh;
  background-color: #f8f7f4;
}

.page-with-tabbar {
  padding-bottom: 140rpx;
}

/* === 自定义导航栏 === */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #f8f7f4;
}

.nav-placeholder {
  width: 100%;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  position: relative;
}

.navbar-left, .navbar-right {
  width: 80rpx;
  height: 100%;
  display: flex;
  align-items: center;
}

.navbar-center {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.navbar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
}

/* === 内容区域 === */
.content-area {
  padding: 24rpx 32rpx;
  padding-bottom: 40rpx;
}

/* === 当前订单卡片 === */
.order-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-top: 16rpx;
  transition: all 0.2s cubic-bezier(0.23, 1, 0.32, 1);
}

.order-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 状态横幅 */
.status-banner {
  padding: 32rpx 32rpx 28rpx;
}

.status-main {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
}

.status-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
  line-height: 1.4;
}

/* 状态横幅颜色 */
.status-unpaid {
  background-color: #F59E0B;
}

.status-pending {
  background-color: #3B82F6;
}

.status-doing {
  background-color: #8B5CF6;
}

.status-done {
  background-color: #22C55E;
}

.status-cancelled {
  background-color: #9CA3AF;
}

/* === 进度条 === */
.progress-bar {
  padding: 20rpx 0 28rpx;
}

.progress-track {
  display: flex;
  align-items: center;
  padding: 0 16rpx;
}

.progress-node {
  flex: 1;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.progress-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #e0e0e0;
  position: relative;
  z-index: 1;
  transition: all 0.3s ease;
}

.progress-dot.done {
  background-color: #1a1a1a;
}

.progress-dot.active {
  background-color: #1a1a1a;
  box-shadow: 0 0 0 4rpx rgba(26, 26, 26, 0.15);
}

.progress-line {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 3rpx;
  margin-top: -1.5rpx;
  background-color: #e0e0e0;
  transition: all 0.3s ease;
}

.progress-line.done {
  background-color: #1a1a1a;
}

.progress-labels {
  display: flex;
  padding: 16rpx 16rpx 0;
}

.progress-label {
  font-size: 20rpx;
  color: #cccccc;
  text-align: center;
  flex: 1;
  transition: all 0.3s ease;
}

.progress-label.highlight {
  color: #1a1a1a;
  font-weight: 600;
}

/* 信息区域 */
.info-section {
  padding: 28rpx 32rpx 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #b0b0b0;
  width: 120rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 500;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price-wrap {
  display: flex;
  align-items: baseline;
  color: #1a1a1a;
}

.price-symbol {
  font-size: 24rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-right: 2rpx;
}

.price-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

/* 卡片底部操作区 */
.card-action {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 20rpx 32rpx 28rpx;
  border-top: 1rpx solid #f0f0f0;
  gap: 8rpx;
}

.action-text {
  font-size: 26rpx;
  color: #999999;
  font-weight: 500;
}

.arrow-icon {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid #999999;
  border-bottom: 3rpx solid #999999;
  transform: rotate(-45deg);
}

/* === 历史订单列表 === */
.history-section {
  margin-top: 40rpx;
}

.history-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.history-item {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 1rpx 8rpx rgba(0, 0, 0, 0.03);
  transition: all 0.2s cubic-bezier(0.23, 1, 0.32, 1);
}

.history-item:active {
  transform: scale(0.98);
  opacity: 0.85;
}

.history-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.history-item-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-item-time {
  font-size: 22rpx;
  color: #b0b0b0;
}

.history-arrow {
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid #cccccc;
  border-bottom: 2rpx solid #cccccc;
  transform: rotate(-45deg);
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 历史订单状态标签 */
.history-item .status-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.history-item .status-tag text {
  font-size: 20rpx;
}

.history-item .status-unpaid {
  background-color: rgba(245, 158, 11, 0.08);
  color: #F59E0B;
}

.history-item .status-pending {
  background-color: rgba(59, 130, 246, 0.08);
  color: #3B82F6;
}

.history-item .status-doing {
  background-color: rgba(139, 92, 246, 0.08);
  color: #8B5CF6;
}

.history-item .status-done {
  background-color: rgba(34, 197, 94, 0.08);
  color: #22C55E;
}

.history-item .status-cancelled {
  background-color: rgba(176, 176, 176, 0.1);
  color: #999999;
}

/* === 空状态 === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 40rpx 80rpx;
}

.empty-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-char {
  font-size: 48rpx;
  font-weight: 700;
  color: #d0d0d0;
}

.empty-text {
  font-size: 28rpx;
  color: #b0b0b0;
  font-weight: 500;
  margin-bottom: 36rpx;
}

.empty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 48rpx;
  background-color: #1a1a1a;
  border-radius: 36rpx;
  transition: all 0.2s;
}

.empty-btn text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
}

.empty-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

/* === 加载中 === */
.loading-state {
  text-align: center;
  padding: 80rpx;
  color: #b0b0b0;
  font-size: 26rpx;
}

.bottom-spacing {
  height: 40rpx;
}

/* === Tab栏容器 === */
.tab-bar-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.tab-bar-blur {
  position: absolute;
  top: -140rpx;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    to bottom,
    rgba(248,247,244,0)      0%,
    rgba(248,247,244,0)     10%,
    rgba(248,247,244,0.08)  20%,
    rgba(248,247,244,0.22)  30%,
    rgba(248,247,244,0.42)  40%,
    rgba(248,247,244,0.65)  50%,
    rgba(248,247,244,0.85)  58%,
    rgba(248,247,244,0.96)  65%,
    rgba(248,247,244,1)     72%,
    rgba(248,247,244,1)    100%
  );
  backdrop-filter: blur(20px) saturate(140%);
  -webkit-backdrop-filter: blur(20px) saturate(140%);
  -webkit-mask-image: linear-gradient(
    to bottom,
    transparent             0%,
    transparent            10%,
    rgba(0,0,0,0.08)       20%,
    rgba(0,0,0,0.22)       30%,
    rgba(0,0,0,0.42)       40%,
    rgba(0,0,0,0.65)       50%,
    rgba(0,0,0,0.85)       58%,
    rgba(0,0,0,0.96)       65%,
    black                  72%,
    black                 100%
  );
  mask-image: linear-gradient(
    to bottom,
    transparent             0%,
    transparent            10%,
    rgba(0,0,0,0.08)       20%,
    rgba(0,0,0,0.22)       30%,
    rgba(0,0,0,0.42)       40%,
    rgba(0,0,0,0.65)       50%,
    rgba(0,0,0,0.85)       58%,
    rgba(0,0,0,0.96)       65%,
    black                  72%,
    black                 100%
  );
  pointer-events: none;
}

.tab-bar-icons {
  position: relative;
  display: flex;
  padding: 12rpx 32rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  transition: all 0.2s;
  background: transparent;
  border: none;
  margin: 0;
  width: auto;
  height: auto;
  line-height: normal;
  font-size: inherit;
  border-radius: 0;
  box-shadow: none;
  overflow: visible;
}

.tab-item::after {
  border: none;
}

.tab-icon {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 6rpx;
  transition: opacity 0.2s;
}

.tab-label {
  font-size: 24rpx;
  color: #999999;
  font-weight: 500;
  transition: all 0.2s;
}

.tab-contact {
  flex: 1;
}

.tab-item.active .tab-label {
  color: #1a1a1a;
  font-weight: 600;
}

.tab-item.active .tab-icon {
  opacity: 1;
}

/* ===== 个人信息卡片 ===== */
.profile-card {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 24rpx;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: #f0eee8;
}

.profile-avatar-img {
  width: 100%;
  height: 100%;
}

.profile-avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #1a1a1a;
}

.profile-avatar-placeholder text {
  font-size: 40rpx;
  color: #ffffff;
  font-weight: 600;
}

.profile-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.profile-nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.profile-tip {
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 6rpx;
}

.profile-edit-arrow {
  width: 18rpx;
  height: 18rpx;
  border-top: 3rpx solid #c9c9c9;
  border-right: 3rpx solid #c9c9c9;
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* ===== 编辑头像昵称模态 ===== */
.user-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-modal {
  width: 600rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
}

.user-modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  text-align: center;
}

.user-modal-sub {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  margin-top: 12rpx;
  margin-bottom: 40rpx;
}

.avatar-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 180rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #f5f5f5;
  padding: 0;
  line-height: normal;
  overflow: hidden;
  position: relative;
}

.avatar-picker::after {
  border: none;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.avatar-plus {
  font-size: 48rpx;
  color: #b0b0b0;
  line-height: 1;
}

.avatar-hint {
  font-size: 20rpx;
  color: #999999;
  margin-top: 8rpx;
}

.nickname-input-wrap {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  background: #f8f7f4;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
}

.nickname-label {
  font-size: 28rpx;
  color: #1a1a1a;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.nickname-input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
}

.user-modal-btns {
  display: flex;
  align-items: center;
  margin-top: 48rpx;
  gap: 20rpx;
}

.btn-skip {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 24rpx;
  background: #f5f5f5;
  color: #999999;
  font-size: 30rpx;
}

.btn-skip:active {
  opacity: 0.8;
}

.btn-save {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 24rpx;
  background: #1a1a1a;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-save.disabled {
  background: #d8d8d8;
  color: #ffffff;
}

.btn-save:active {
  opacity: 0.85;
}