/* 订单详情页样式（对齐 my-detail） */
.page-container {
  min-height: 100vh;
  background-color: #f8f7f4;
  position: relative;
}

.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #f8f7f4;
}

.nav-placeholder {
  width: 100%;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  position: relative;
}

.navbar-left,
.navbar-right {
  width: 80rpx;
  height: 100%;
  display: flex;
  align-items: center;
}

.navbar-left {
  padding-left: 8rpx;
}

.back-icon {
  width: 22rpx;
  height: 22rpx;
  border-left: 4rpx solid #1a1a1a;
  border-bottom: 4rpx solid #1a1a1a;
  transform: rotate(45deg);
}

.navbar-center {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
}

.navbar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.content-area {
  padding: 24rpx 32rpx;
  padding-bottom: 240rpx;
}

/* 状态卡片 */
.status-card {
  border-radius: 24rpx;
  padding: 36rpx;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.status-card.status-unpaid { background-color: #F59E0B; }
.status-card.status-pending { background-color: #3B82F6; }
.status-card.status-doing { background-color: #8B5CF6; }
.status-card.status-done { background-color: #22C55E; }
.status-card.status-cancelled { background-color: #9CA3AF; }

.status-main-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
  margin-bottom: 10rpx;
}

.status-sub-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
  display: block;
}

/* 信息卡 */
.info-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.info-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #b0b0b0;
  width: 120rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-value.file-name {
  font-weight: 600;
}

.remark-text {
  white-space: normal;
  word-break: break-all;
  line-height: 1.6;
}

.phone-link {
  color: #3B82F6;
}

.price-wrap {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-right: 2rpx;
}

.price-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

/* 文件行 */
.file-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}

.file-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  background-color: #E3EDFC;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.file-icon-char {
  font-size: 36rpx;
  font-weight: 700;
  color: #2B7CD3;
}

.file-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  overflow: hidden;
}

.file-name-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-tip-text {
  font-size: 24rpx;
  color: #b0b0b0;
}

.arrow-right {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #cccccc;
  border-bottom: 3rpx solid #cccccc;
  transform: rotate(-45deg);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.bottom-spacing {
  height: 40rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #f8f7f4;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #1a1a1a;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.btn-primary:active {
  background: #333333;
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-outline {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #ffffff;
  color: #1a1a1a;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  text-align: center;
  border: 2rpx solid #e5e5e5;
  letter-spacing: 2rpx;
}

.btn-outline:active {
  background: #f5f5f5;
  transform: scale(0.98);
}

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  color: #b0b0b0;
  font-size: 28rpx;
}