/* 订单详情页样式 */
.container {
  min-height: 100vh;
  background: #f0f2f5;
  padding-bottom: 60rpx;
  padding-top: 132rpx;
}

/* === 自定义导航栏 === */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: #ffffff;
  border-bottom: 1rpx solid #f3f4f6;
}

.nav-placeholder {
  background: #ffffff;
}

.nav-back {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  height: 88rpx;
}

.back-icon {
  width: 24rpx;
  height: 24rpx;
  border-left: 3rpx solid #111827;
  border-bottom: 3rpx solid #111827;
  transform: rotate(45deg);
  margin-right: 20rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

/* === 状态横幅 === */
.status-banner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 48rpx;
}

.status-banner.status-pending { background: linear-gradient(135deg, #fff8e1 0%, #ffecb3 100%); }
.status-banner.status-doing { background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%); }
.status-banner.status-done { background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%); }
.status-banner.status-cancelled { background: linear-gradient(135deg, #fce4ec 0%, #f8bbd0 100%); }

.status-text {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.status-pending .status-text { color: #b8860b; }
.status-doing .status-text { color: #1565c0; }
.status-done .status-text { color: #2e7d32; }
.status-cancelled .status-text { color: #c62828; }

.status-time {
  font-size: 24rpx;
  color: rgba(0,0,0,0.35);
  margin-top: 10rpx;
}

/* === 卡片 === */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx;
  margin: 24rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 28rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #c9974b;
  border-radius: 4rpx;
}

.info-row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  align-items: flex-start;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #aaa;
  width: 120rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.remark-text {
  word-break: break-all;
  line-height: 1.6;
  color: #555;
}

.phone-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
}

.call-btn {
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #1a1a2e 0%, #263859 100%);
  padding: 10rpx 28rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* === 文件 === */
.file-box {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #f8f9ff 0%, #f0f4ff 100%);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid #e3e8f0;
  transition: all 0.2s;
}

.file-box:active {
  background: #e8eeff;
  border-color: #c9974b;
}

.file-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, #2b579a 0%, #1a3a6e 100%);
  border-radius: 14rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.file-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.file-name {
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: 600;
  word-break: break-all;
}

.file-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.download-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.download-icon {
  position: relative;
  width: 24rpx;
  height: 24rpx;
}
.download-icon::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  width: 4rpx;
  height: 18rpx;
  background: #2b579a;
  transform: translateX(-50%);
}
.download-icon::after {
  content: '';
  position: absolute;
  left: 2rpx;
  bottom: 0;
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid #2b579a;
  border-bottom: 4rpx solid #2b579a;
  transform: rotate(45deg);
}
.download-icon.downloading::before {
  background: #ccc;
}
.download-icon.downloading::after {
  border-color: #ccc;
}

/* === 金额 === */
.total-row {
  padding-top: 22rpx;
  border-top: 2rpx solid #eee;
  margin-top: 10rpx;
}

.total-price {
  font-size: 40rpx;
  color: #c9974b;
  font-weight: 800;
}

.pay-tip {
  font-size: 22rpx;
  color: #bbb;
  text-align: right;
  margin-top: 10rpx;
}

.order-no {
  font-size: 24rpx;
  color: #aaa;
  font-family: monospace;
}

/* === 操作按钮 === */
.action-area {
  padding: 20rpx 48rpx;
}

.cancel-btn {
  margin-top: 20rpx;
}

/* === 加载中 === */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 60vh;
  color: #bbb;
  font-size: 28rpx;
}