<view class="page-container page-fullscreen" style="height: {{windowHeight}}px;" catchtouchmove="preventScroll">
  <!-- 全屏背景图：aspectFill等比铺满不变形，左右居中裁剪，竖向底部对齐+上移 -->
  <image class="bg-image" src="/images/home-bg.png" mode="aspectFill"></image>

  <!-- 立即书写按钮 -->
  <view class="bottom-bar">
    <view class="btn-primary" bindtap="goOrder">立即书写</view>
  </view>

  <!-- 底部导航区域 -->
  <view class="tab-bar-container">
    <!-- 模糊层：向上延伸+mask渐隐，实现自然过渡 -->
    <view class="tab-bar-blur"></view>
    <!-- 图标文字层 -->
    <view class="tab-bar-icons">
      <view class="tab-item {{currentTab === 'home' ? 'active' : ''}}" bindtap="onTabHome">
        <image class="tab-icon" src="{{currentTab === 'home' ? '/images/tabbar/home-active.png' : '/images/tabbar/home.png'}}"/>
        <text class="tab-label">首页</text>
      </view>
      <view class="tab-item tab-contact" bindtap="onGoContact">
        <image class="tab-icon" src="{{currentTab === 'chat' ? '/images/tabbar/chat-active.png' : '/images/tabbar/chat.png'}}"/>
        <text class="tab-label">咨询</text>
      </view>
      <view class="tab-item {{currentTab === 'my' ? 'active' : ''}}" bindtap="onTabMy">
        <image class="tab-icon" src="{{currentTab === 'my' ? '/images/tabbar/user-active.png' : '/images/tabbar/user.png'}}"/>
        <text class="tab-label">我的</text>
      </view>
    </view>
  </view>

  <!-- 首次进入：完善头像昵称引导 -->
  <view class="user-modal-mask" wx:if="{{showUserModal}}" catchtouchmove="preventScroll">
    <view class="user-modal">
      <view class="user-modal-title">完善您的资料</view>
      <view class="user-modal-sub">设置头像和昵称，方便我们为您服务</view>

      <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" loading="{{avatarUploading}}">
        <image wx:if="{{avatarTempPath}}" class="avatar-preview" src="{{avatarTempPath}}" mode="aspectFill"></image>
        <view wx:else class="avatar-placeholder">
          <text class="avatar-plus">＋</text>
          <text class="avatar-hint">选择头像</text>
        </view>
      </button>

      <view class="nickname-input-wrap">
        <text class="nickname-label">昵称</text>
        <input class="nickname-input" type="nickname" placeholder="请输入昵称" value="{{nicknameDraft}}" bindinput="onNicknameInput" maxlength="20"/>
      </view>

      <view class="user-modal-btns">
        <view class="btn-skip" bindtap="skipUserModal">暂不设置</view>
        <view class="btn-save {{userInfoReady ? '' : 'disabled'}}" bindtap="saveUserInfo">保存</view>
      </view>
    </view>
  </view>
</view>
