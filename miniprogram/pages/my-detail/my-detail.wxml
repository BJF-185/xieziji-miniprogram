<view class="page-container" wx:if="{{order}}">
  <view class="custom-navbar">
    <view class="nav-placeholder" style="height: {{statusBarHeight}}px;"></view>
    <view class="navbar-content">
      <view class="navbar-left" bindtap="goBack">
        <view class="back-icon"></view>
      </view>
      <view class="navbar-center">
        <text class="navbar-title">订单详情</text>
      </view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <view class="content-area" style="padding-top: {{navHeight}}px;">
    <view class="status-card status-{{order.payStatus === 'unpaid' && order.status === 'unpaid' ? 'unpaid' : (order.status === 'doing' ? 'doing' : (order.status === 'done' ? 'done' : 'pending'))}}">
      <text class="status-main-text">{{statusText}}</text>
      <text class="status-sub-text">{{statusDesc}}</text>
    </view>

    <view class="info-card">
      <view class="info-row">
        <text class="info-label">文件名</text>
        <text class="info-value file-name">{{order.fileName}}</text>
      </view>
      <view class="info-row" wx:if="{{order.wordCount}}">
        <text class="info-label">字数</text>
        <text class="info-value">{{order.wordCount}} 字</text>
      </view>
      <view class="info-row" wx:if="{{order.price}}">
        <text class="info-label">金额</text>
        <view class="info-value price-wrap">
          <text class="price-symbol">¥</text>
          <text class="price-num">{{order.price}}</text>
        </view>
      </view>
      <view class="info-row">
        <text class="info-label">提交时间</text>
        <text class="info-value">{{createTimeStr}}</text>
      </view>
    </view>

    <view class="info-card" wx:if="{{order.fileID}}">
      <view class="file-row" bindtap="downloadFile">
        <view class="file-icon-wrap">
          <text class="file-icon-char">W</text>
        </view>
        <view class="file-meta">
          <text class="file-name-text">{{order.fileName}}</text>
          <text class="file-tip-text">点击下载查看</text>
        </view>
        <view class="arrow-right"></view>
      </view>
    </view>

    <view class="info-card">
      <view class="info-row">
        <text class="info-label">姓名</text>
        <text class="info-value">{{order.name}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">手机号</text>
        <text class="info-value phone-link" bindtap="makeCall">{{order.phone}}</text>
      </view>
      <view class="info-row" wx:if="{{order.notebookSize}}">
        <text class="info-label">本子类型</text>
        <text class="info-value">{{order.notebookSize}}</text>
      </view>
      <view class="info-row" wx:if="{{order.pageCount}}">
        <text class="info-label">写几页</text>
        <text class="info-value">{{order.pageCount}} 页</text>
      </view>
      <view class="info-row" wx:if="{{order.dormNo}}">
        <text class="info-label">宿舍楼</text>
        <text class="info-value">{{order.dormNo}}</text>
      </view>
      <view class="info-row" wx:if="{{order.remark}}">
        <text class="info-label">备注</text>
        <text class="info-value remark-text">{{order.remark}}</text>
      </view>
    </view>

    <view class="bottom-spacing"></view>
  </view>

  <view class="bottom-bar">
    <block wx:if="{{order.payStatus === 'unpaid'}}">
      <view class="btn-primary" bindtap="goPayment">立即支付</view>
    </block>
    <block wx:if="{{order.status !== 'cancelled' && order.status !== 'doing' && order.status !== 'done'}}">
      <view class="btn-outline" bindtap="cancelOrder">取消订单</view>
    </block>
    <button class="btn-contact" open-type="contact">联系我</button>
  </view>
</view>

<view class="loading-state" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
